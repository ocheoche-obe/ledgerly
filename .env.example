# Local-only Plaid Sandbox settings. Copy to `.env` and fill in the values there.
# `.env` is gitignored - never commit it, and never put values in this file.
#
# The deployed Lambdas do NOT read these: they read the Plaid keys from AWS Secrets Manager
# (ADR-014). This file is only for running Plaid calls from a workstation.
#
# The Plaid CLI can write `.env` for you without the secret ever being displayed:
#   plaid keys write --env sandbox --gitignore

# Plaid Dashboard -> Developers -> Keys -> client_id
PLAID_CLIENT_ID=
# Plaid Dashboard -> Developers -> Keys -> the *Sandbox* secret (never the Production one)
PLAID_SECRET=
# Must be: sandbox
PLAID_ENV=
